@startuml k8s-petclinic-architecture
title Spring PetClinic Microservices - Kubernetes Architecture (Deployed)

package "Minikube Cluster (minikube-petclinic)" {
    package "spring-petclinic namespace" {
        
        component "LoadBalancer\n:31428" as lb
        component "API Gateway Pod\n(1/1 Running)" as gw
        component "Customers Service Pod\n(1/1 Running)" as customers
        component "Vets Service Pod\n(1/1 Running)" as vets
        component "Visits Service Pod\n(1/1 Running)" as visits
        component "Billing Service Pod\n(1/1 Running)" as billing
        component "GenAI Service Pod\n(1/1 Running)" as genai
        
        database "customers-db-mysql-0\n(StatefulSet)" as custdb
        database "vets-db-mysql-0\n(StatefulSet)" as vetsdb
        database "visits-db-mysql-0\n(StatefulSet)" as visitsdb
        database "billing-db-mysql-0\n(StatefulSet)" as billdb
        
        artifact "ConfigMap\npetclinic-config" as cm
        
        lb --> gw : "http://127.0.0.1:50838"
        gw --> customers : "customers-service:8080"
        gw --> vets : "vets-service:8080"
        gw --> visits : "visits-service:8080"
        gw --> billing : "billing-service:8080"
        gw --> genai : "genai-service:8080"
        
        billing ..> customers : "Feign Client\n(k8s DNS)"
        billing ..> visits : "Feign Client\n(k8s DNS)"
        
        customers --> custdb : "Port 3306"
        vets --> vetsdb : "Port 3306"
        visits --> visitsdb : "Port 3306"
        billing --> billdb : "Port 3306"
        
        cm ..> gw : "mounted"
        cm ..> customers : "mounted"
        cm ..> vets : "mounted"
        cm ..> visits : "mounted"
        cm ..> billing : "mounted"
        cm ..> genai : "mounted"
    }
}

note top : Successfully deployed with all services running
note bottom : Images: springcommunity/spring-petclinic-*:latest

@enduml